{
  "info": {
    "name": "Product Catalog Service - Full CRUD Assignment",
    "description": "Dokumentasi Postman untuk Mini Project Back-End AI-First. GET katalog (q, category, minPrice, maxPrice, sort), detail, POST, PUT (partial update sesuai implementasi), DELETE, dan validasi 400/404. Jalankan server localhost:3000. Folder CRUD dijalankan berurutan karena membuat lalu menghapus data sementara",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Browse & Detail",
      "item": [
        {
          "name": "All products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products",
            "description": "PR-001: mengembalikan daftar 9 produk, dengan field data dan total."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Total 9 products\", function () { const body = pm.response.json(); pm.expect(body.total.to.eql(9)); });",
                  "pm.test(\"Array data\", function () { const body = pm.response.json(); pm.expect(body.data.to.be.an(\"array\")); });",
                  "pm.test(\"Required fields\", function () { const body = pm.response.json(); pm.expect(body.data[0].to.have.all.keys(\"id\",\"name\",\"description\",\"category\",\"price\",\"image\",\"variants\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Detail product ID 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/1",
            "description": "PR-006: detail produk berdasarkan ID."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"ID is 1\", function () { const body = pm.response.json(); pm.expect(body.id.to.eql(1)); });",
                  "pm.test(\"Variant fields present\", function () { const body = pm.response.json(); pm.expect(body.variants.to.have.all.keys(\"colorOrSize\",\"quantity\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Missing product ID 99",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/99",
            "description": "PR-006: produk tidak ditemukan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", function () { pm.response.to.have.status(404); });",
                  "pm.test(\"Not found message\", function () { const body = pm.response.json(); pm.expect(body.message.to.include(\"tidak ditemukan\")); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
