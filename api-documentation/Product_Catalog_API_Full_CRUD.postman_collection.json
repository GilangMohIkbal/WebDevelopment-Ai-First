    {
      "name": "05 - Combined",
      "item": [
        {
          "name": "Search + category + min price + sorting",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?q=sepatu&category=Footwear&minPrice=300000&sort=price_desc",
            "description": "PR-007: beberapa kriteria diterapkan bersama."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Two matched footwear items\", function () { const body = pm.response.json(); pm.expect(body.total.to.eql(2)); });",
                  "pm.test(\"Sort and category\", function () { const body = pm.response.json(); pm.expect(body.data.every(p=>p.category===\"Footwear\" && p.price>=300000).to.be.true && body.data[0].price >= body.data[1].price); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "06 - CRUD Mutation Flow (run sequentially)",
      "description": "Jalankan request dalam folder ini dari atas ke bawah. POST menyimpan {{createdProductId}} sebagai Collection Variable, PUT memperbaruinya, DELETE menghapusnya. Jika Anda menjalankan sebagian request secara terpisah, pastikan produk test telah dibuat.",
      "item": [
        {
          "name": "01 - POST Create product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "Membuat produk baru, menyimpan ID untuk test berikutnya. Gunakan Collection Run berurutan.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jam Tangan Digital\",\n  \"description\": \"Jam tangan digital dengan stopwatch dan tahan air.\",\n  \"category\": \"Electronics\",\n  \"price\": 250000,\n  \"image\": \"https://picsum.photos/seed/jam-tangan-digital/400/400\",\n  \"variants\": {\n    \"colorOrSize\": [\n      \"Black\",\n      \"Silver\"\n    ],\n    \"quantity\": 20\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const p=pm.response.json(); pm.expect(p.name).to.eql(\"Jam Tangan Digital\"); pm.expect(p.id).to.be.a(\"number\"); pm.collectionVariables.set(\"createdProductId\",String(p.id));"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - GET Verify created",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "Memastikan produk baru tersedia setelah POST."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().name).to.eql(\"Jam Tangan Digital\");"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - PUT Partial price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "PUT pada implementasi ini menerima body parsial; hanya harga yang berubah.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 300000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const p=pm.response.json(); pm.expect(p.price).to.eql(300000); pm.expect(p.variants.quantity).to.eql(20);"
                ]
              }
            }
          ]
        },
        {
          "name": "04 - PUT Partial variant quantity",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "Update quantity saja tanpa mengubah colorOrSize.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"variants\": {\n    \"quantity\": 99\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const p=pm.response.json(); pm.expect(p.variants.quantity).to.eql(99); pm.expect(p.variants.colorOrSize).to.eql([\"Black\",\"Silver\"]);"
                ]
              }
            }
          ]
        },
        {
          "name": "05 - GET Verify updated",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "Verifikasi seluruh perubahan PUT."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const p=pm.response.json(); pm.expect(p.price).to.eql(300000); pm.expect(p.variants.quantity).to.eql(99);"
                ]
              }
            }
          ]
        },
        {
          "name": "06 - POST Invalid missing fields",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products",
            "description": "POST invalid harus menghasilkan daftar errors tanpa menambah data.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 50000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.expect(pm.response.json().errors).to.be.an(\"array\").that.is.not.empty;"
                ]
              }
            }
          ]
        },
        {
          "name": "07 - PUT Invalid negative price",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "Harga negatif tidak boleh diterima.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": -100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
                  "pm.expect(pm.response.json().errors).to.be.an(\"array\").that.is.not.empty;"
                ]
              }
            }
          ]
        },
        {
          "name": "08 - PUT Not found",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/api/products/999",
            "description": "Produk ID 999 tidak ada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 1000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "09 - DELETE Created product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "Hapus hanya produk yang dibuat pada langkah 1, jangan hapus data asli."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().message).to.include(\"berhasil dihapus\");"
                ]
              }
            }
          ]
        },
        {
          "name": "10 - GET Verify deleted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{createdProductId}}",
            "description": "ID yang dihapus harus menghasilkan 404."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "11 - DELETE Not found",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/999",
            "description": "DELETE pada ID tidak ada harus 404."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 404\", () => pm.response.to.have.status(404));"
                ]
              }
