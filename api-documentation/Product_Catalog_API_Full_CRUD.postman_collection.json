          ]
        },
        {
          "name": "12 - GET Verify original count",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products",
            "description": "Jumlah dataset kembali ke 9 setelah CRUD flow."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().total).to.eql(9);"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "createdProductId",
      "value": "10",
      "type": "string"
    }
  ]
}
