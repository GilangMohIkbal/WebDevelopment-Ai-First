    {
      "name": "03 - Category & Price",
      "item": [
        {
          "name": "Filter Electronics",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?category=Electronics",
            "description": "PR-003: kategori exact case-insensitive."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Two electronic products\", function () { const body = pm.response.json(); pm.expect(body.total.to.eql(2)); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Inclusive price bounds",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?minPrice=120000&maxPrice=180000",
            "description": "PR-004: kedua harga pada batas harus termasuk."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Two products at inclusive bounds\", function () { const body = pm.response.json(); pm.expect(body.total.to.eql(2)); });",
                  "pm.test(\"Every price within range\", function () { const body = pm.response.json(); pm.expect(body.data.every(p => p.price >= 120000 && p.price <= 180000).to.be.true); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Invalid price range",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?minPrice=500000&maxPrice=100000",
            "description": "PR-004: minimum lebih besar dari maksimum."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Helpful error message\", function () { const body = pm.response.json(); pm.expect(body.message.to.include(\"minPrice\")); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Invalid numeric price",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?minPrice=abc",
            "description": "PR-004: minPrice bukan angka."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"Helpful numeric error\", function () { const body = pm.response.json(); pm.expect(body.message.to.include(\"angka\")); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "04 - Sorting",
      "item": [
        {
          "name": "Sort price descending",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products?sort=price_desc",
            "description": "PR-005: harga terbesar ke terkecil."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Sorted descending\", function () { const body = pm.response.json(); pm.expect(body.data.every((p,i,a) => i === 0 || a[i-1].price >= p.price).to.be.true); });"
                ]
              }
            }
          ],
          "response": []
        },
